<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="NSwag.AspNetCore" Version="14.7.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MercadoCercano.Application\MercadoCercano.Application.csproj" />
    <ProjectReference Include="..\MercadoCercano.Infrastructure\MercadoCercano.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\MercadoCercano.Web\dist\mercado-cercano-web\3rdpartylicenses.txt"
             Link="3rdpartylicenses.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\deployment\iis\*.ps1" Exclude="..\..\deployment\iis\Publish-Iis.ps1"
             Link="operations\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequireAngularForPublish" BeforeTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('..\MercadoCercano.Web\dist\mercado-cercano-web\browser\index.html')"
           Text="Compila Angular con npm run build antes de publicar la API para IIS." />
  </Target>

  <Target Name="IncludeAngularForPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_AngularPublishFile Include="..\MercadoCercano.Web\dist\mercado-cercano-web\browser\**\*" />
      <ResolvedFileToPublish Include="@(_AngularPublishFile)">
        <RelativePath>wwwroot\%(_AngularPublishFile.RecursiveDir)%(_AngularPublishFile.Filename)%(_AngularPublishFile.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
